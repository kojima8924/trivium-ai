// Trivium - Prisma schema
// 概念:
//   learning_events  = episodic memory(生ログ)
//   domain_profiles  = semantic memory(READ/WRITE/CODE ごとの推定)
//   leader_profiles  = semantic memory(学習者全体の推定)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Domain {
  READ
  WRITE
  CODE
}

// ---------- Auth.js (Google identity) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  learningEvents LearningEvent[]
  taskAttempts   TaskAttempt[]
  domainProfiles DomainProfile[]
  leaderProfile  LeaderProfile?
  achievements   Achievement[]
  lineUsers      LineUser[]
  personas       AgentPersona[]
  memories       AgentMemory[]
  chatTurns      ChatTurn[]
  generatedTasks GeneratedTask[]
  dailyDigests   DailyDigest[]
  snapshots      ProfileSnapshot[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Episodic memory ----------

model LearningEvent {
  id         String   @id @default(cuid())
  userId     String
  domain     Domain
  taskId     String
  difficulty Int // 1..5
  answer     String
  success    Boolean
  hintCount  Int      @default(0)
  latencyMs  Int?
  skillTags  String[]
  // 難易度ベクトル（1..10、0 = その系統に無関係）。複合課題は複数が正。旧データは 0 のまま（difficulty を主系統に使う）
  axisRead   Int      @default(0)
  axisWrite  Int      @default(0)
  axisCode   Int      @default(0)
  /** LLM が作った課題か（XP 倍率に使う） */
  generated  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, domain, createdAt])
}

// ---------- 進行中の挑戦（ヒント回数の正本。決着したら削除する） ----------

model TaskAttempt {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  hintCount Int      @default(0)
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

// ---------- Semantic memory (per domain) ----------

model DomainProfile {
  id              String   @id @default(cuid())
  userId          String
  domain          Domain
  score           Float    @default(0) // 0..100 集計値(evidence)。小数 1 桁（到達レベル×10 + 進捗）
  subskills       Json     @default("{}") // { comprehension: 78, ... }
  confidence      String   @default("low") // low | medium | high
  evidenceCount   Int      @default(0)
  summary         String   @default("") // AIによる寸評(interpretation)
  observations    Json     @default("[]") // string[]
  recommendedNext String   @default("")
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
}

// ---------- Semantic memory (global learner model) ----------

model LeaderProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  summary        String   @default("")
  interests      String[]
  preferences    Json     @default("{}")
  observations   Json     @default("[]")
  recommendation String   @default("")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- AI の人格（READ / WRITE / CODE / LEADER。ユーザーごとに上書き可） ----------

model AgentPersona {
  id          String   @id @default(cuid())
  userId      String
  agent       String // READ | WRITE | CODE | LEADER
  name        String
  tone        String   @default("polite") // polite | casual | senior | coach
  firstPerson String   @default("私")
  extra       String   @default("") // 自由記述（口癖・スタンスなど。prompt に追記）
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agent])
}

// ---------- エージェントの観察メモ（本人には見せない。LLM が書く。数値は書かせない） ----------

model AgentMemory {
  id        String   @id @default(cuid())
  userId    String
  agent     String // READ | WRITE | CODE | LEADER
  notes     String   @default("")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agent])
}

// ---------- LINE の会話履歴（人格ごと。直近 N 往復だけ prompt に渡す） ----------

model ChatTurn {
  id        String   @id @default(cuid())
  userId    String
  agent     String // READ | WRITE | CODE | LEADER
  role      String // user | assistant
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agent, createdAt])
}

// ---------- LLM が作問した課題（LINE の自由文リクエスト等）。通常の Task と同じ形で扱う ----------

model GeneratedTask {
  id         String   @id // "gen-xxxx"
  userId     String
  domain     Domain
  difficulty Int
  axisRead   Int      @default(0)
  axisWrite  Int      @default(0)
  axisCode   Int      @default(0)
  title      String
  passage    String   @default("")
  prompt     String
  kind       String // choice | short | free
  choices    Json? // string[]
  answerKey  Json? // string[]
  rubric     Json? // { mustInclude, minLength, maxLength, criteria }
  hints      Json // string[]
  explanation String
  skillTags  String[]
  request    String   @default("") // 元になった依頼文
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- 選択式の講評キャッシュ（タスク×回答×ヒント段階×人格） ----------

model TaskFeedbackCache {
  id        String   @id @default(cuid())
  taskId    String
  answer    String
  hintLevel Int
  personaKey String  @default("default")
  payload   Json // DomainEvalOutput
  createdAt DateTime @default(now())

  @@unique([taskId, answer, hintLevel, personaKey])
}

// ---------- 「今日の3問」完了通知の送信記録（1日1回） ----------

model DailyDigest {
  id      String   @id @default(cuid())
  userId  String
  day     String // YYYY-MM-DD (JST)
  sentAt  DateTime @default(now())
  summary String   @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// ---------- 能力の時系列（profile 再計算のたびに 1 行） ----------

model ProfileSnapshot {
  id        String   @id @default(cuid())
  userId    String
  read      Float
  write     Float
  code      Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- Achievements ----------

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  key        String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ---------- LINE (Web accountとは独立して開始できる) ----------

// LINE ↔ Web アカウントの連携トークン（ワンタイム・短命。PII は持たない）
model LineLinkToken {
  token      String    @id
  lineUserId String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([lineUserId])
  @@index([expiresAt])
}

model LineUser {
  id         String   @id @default(cuid())
  lineUserId String   @unique
  userId     String? // 将来的な連携用(任意)
  state      Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}
