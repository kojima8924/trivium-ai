// Trivium - Prisma schema
// 概念:
//   learning_events  = episodic memory(生ログ)
//   domain_profiles  = semantic memory(READ/WRITE/CODE ごとの推定)
//   leader_profiles  = semantic memory(学習者全体の推定)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Domain {
  READ
  WRITE
  CODE
}

// ---------- Auth.js (Google identity) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  learningEvents LearningEvent[]
  taskAttempts   TaskAttempt[]
  domainProfiles DomainProfile[]
  leaderProfile  LeaderProfile?
  achievements   Achievement[]
  lineUsers      LineUser[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Episodic memory ----------

model LearningEvent {
  id         String   @id @default(cuid())
  userId     String
  domain     Domain
  taskId     String
  difficulty Int // 1..5
  answer     String
  success    Boolean
  hintCount  Int      @default(0)
  latencyMs  Int?
  skillTags  String[]
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, domain, createdAt])
}

// ---------- 進行中の挑戦（ヒント回数の正本。決着したら削除する） ----------

model TaskAttempt {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  hintCount Int      @default(0)
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

// ---------- Semantic memory (per domain) ----------

model DomainProfile {
  id              String   @id @default(cuid())
  userId          String
  domain          Domain
  score           Int      @default(0) // 0..100 集計値(evidence)
  subskills       Json     @default("{}") // { comprehension: 78, ... }
  confidence      String   @default("low") // low | medium | high
  evidenceCount   Int      @default(0)
  summary         String   @default("") // AIによる寸評(interpretation)
  observations    Json     @default("[]") // string[]
  recommendedNext String   @default("")
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
}

// ---------- Semantic memory (global learner model) ----------

model LeaderProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  summary        String   @default("")
  interests      String[]
  preferences    Json     @default("{}")
  observations   Json     @default("[]")
  recommendation String   @default("")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Achievements ----------

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  key        String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ---------- LINE (Web accountとは独立して開始できる) ----------

// LINE ↔ Web アカウントの連携トークン（ワンタイム・短命。PII は持たない）
model LineLinkToken {
  token      String    @id
  lineUserId String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([lineUserId])
  @@index([expiresAt])
}

model LineUser {
  id         String   @id @default(cuid())
  lineUserId String   @unique
  userId     String? // 将来的な連携用(任意)
  state      Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
