{
  "name": "trivium-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "line:richmenu": "tsx --conditions=react-server scripts/line-richmenu.ts",
    "test": "tsx --test tests/*.test.ts",
    "docker:build": "docker build -t trivium .",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@line/bot-sdk": "^11.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.7.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
