# ---- Trivium 環境変数一覧（実値は絶対にコミットしない） ----

# アプリの公開URL（OAuthコールバック・LINEからの誘導リンクに使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL（Coolify内部ネットワークのDBを指定。5432は外部公開しない）
DATABASE_URL=postgresql://trivium:trivium@localhost:5432/trivium?schema=public

# Auth.js
# 生成例: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Google OAuth（Google Cloud Console → OAuth 2.0 クライアントID）
# 承認済みリダイレクトURI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# デモ用フォールバックログイン（Googleが使えないときの保険。本番では false 推奨）
DEMO_LOGIN_ENABLED=false
# Dashboardの「デモデータ投入」ボタンを有効化
DEMO_SEED_ENABLED=true

# AI layer: "anthropic" | "dify" | "mock"
#   anthropic … Claude API を server-side から直接呼ぶ（設定が最小。推奨）
#   dify      … Dify Workflow 経由（dify/*.yml をインポート）
#   mock      … ルールベース（キー不要）。anthropic/dify が失敗したときも自動で mock にフォールバック
AI_PROVIDER=mock
# Claude API（AI_PROVIDER=anthropic のとき）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_MS=25000
# Dify Cloud: https://api.dify.ai/v1 （self-hostedなら自前URL）
DIFY_API_BASE=https://api.dify.ai/v1
# Domain workflow(read/write/code) 用 API key（Workflow app）
DIFY_DOMAIN_API_KEY=
# Leader workflow 用 API key（Workflow app）
DIFY_LEADER_API_KEY=
# Dify呼び出しのタイムアウト(ms)
DIFY_TIMEOUT_MS=20000

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
