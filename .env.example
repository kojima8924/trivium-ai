# ---- Trivium 環境変数一覧（実値は絶対にコミットしない） ----

# アプリの公開URL（OAuthコールバック・LINEからの誘導リンクに使用）
# NEXT_PUBLIC_APP_URL はビルド時にバンドルへ焼き込まれる（Coolify では Build Variable にする）。
# サーバ側は実行時の APP_URL を優先して読むので、同じ値を APP_URL にも入れておくと安全。
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# PostgreSQL（Coolify内部ネットワークのDBを指定。5432は外部公開しない）
DATABASE_URL=postgresql://trivium:trivium@localhost:5432/trivium?schema=public

# Auth.js
# 生成例: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# リバースプロキシ配下では公開URLを明示する（未設定なら APP_URL から自動補完。localhost 開発時は不要）
AUTH_URL=
# Google OAuth（Google Cloud Console → OAuth 2.0 クライアントID）
# 承認済みリダイレクトURI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# デモ用フォールバックログイン（Googleが使えないときの保険。本番では false 推奨）
DEMO_LOGIN_ENABLED=false
# デモログインの合言葉。設定すると入力必須になり、一致すれば既存アカウントにも入れる（発表者用）。
# 未設定なら「新しい表示名での新規作成」だけ許可（既存アカウントには入れない）
DEMO_LOGIN_SECRET=
# Dashboardの「デモデータ投入」「初期状態に戻す」と /api/demo/warm を有効化（恒久運用では false）
DEMO_SEED_ENABLED=true
# 管理者のメールアドレス（カンマ区切り）。/api/demo/warm（講評キャッシュの事前生成＝LLM を大量に呼ぶ）はこの人だけ
ADMIN_EMAILS=

# AI layer: "openai" | "dify" | "anthropic" | "mock"（未設定は openai）
#   openai    … OpenAI Responses API を server-side から直接呼ぶ（既定・推奨。講評・寸評・ADVISOR・作問・会話。本番の実行時だけ使う。ストックの大量生成は scripts/stock が Codex CLI で行う）
#   dify      … Dify Workflow 経由（dify/*.yml をインポート。LLM は Dify 側も OpenAI）
#   anthropic … Claude API 直接（任意）
#   mock      … ルールベース（キー不要）。上のどれかが失敗したときも自動で mock にフォールバック
AI_PROVIDER=openai
# OpenAI（AI_PROVIDER=openai のとき）
OPENAI_API_KEY=
# 役割ごとのモデル（採点・寸評・会話・作問）は src/config/trivium.config.ts の MODELS で決まる。
# OPENAI_MODEL は役割指定の無い呼び出しの予備。
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=25000
# Claude API（AI_PROVIDER=anthropic のとき。任意・非推奨。整理予定）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_MS=25000
# Dify Cloud: https://api.dify.ai/v1 （self-hostedなら自前URL）
DIFY_API_BASE=https://api.dify.ai/v1
# trivium-domain workflow（回答評価・寸評）の API key
DIFY_DOMAIN_API_KEY=
# trivium-leader workflow（総合寸評）の API key
DIFY_LEADER_API_KEY=
# trivium-generate workflow（作問。無ければ定型問題にフォールバック）の API key
DIFY_GENERATE_API_KEY=
# Dify呼び出しのタイムアウト(ms)。Web 検索を挟む作問があるなら 30000 推奨
DIFY_TIMEOUT_MS=20000
# 教材ナレッジ（Dify Dataset）。未設定ならアプリ内のカタログ（src/lib/materials/catalog.ts）だけで推薦する
# ナレッジ API キー（Dify → ナレッジ → API。アプリの API キーとは別物）
DIFY_DATASET_API_KEY=
# 教材を投入した Dataset の id（scripts/dify/upload_materials.mts が作成時に表示）
DIFY_MATERIALS_DATASET_ID=
# Dify の API ベース（末尾に /v1 を付けない。Dify Cloud なら https://api.dify.ai）
DIFY_BASE_URL=https://api.dify.ai

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
